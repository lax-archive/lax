# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS tooling

ARG LEAN_TOOLCHAIN=leanprover/lean4:v4.30.0
ARG LEAN_VERSION=v4.30.0
ARG MATHLIB_REPOSITORY=https://github.com/leanprover-community/mathlib4
ARG MATHLIB_COMMIT=c5ea00351c28e24afc9f0f84379aa41082b1188f
ARG LAYOUT_VERSION=1
ARG ELAN_COMMIT=3d5138e1526a569a23901b8ee559032793cf445e

ENV DEBIAN_FRONTEND=noninteractive \
    ELAN_HOME=/opt/elan \
    PATH=/opt/elan/bin:/opt/lean/bin:/opt/lax-runtime/bin:$PATH \
    HOME=/opt/lax-runtime/home \
    GIT_TERMINAL_PROMPT=0 \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null

RUN apt-get update && apt-get install --yes --no-install-recommends \
      ca-certificates curl git tar xz-utils zstd && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/elan /opt/lax-runtime/home /opt/lax-runtime/bin

RUN curl --fail --silent --show-error --location \
      "https://raw.githubusercontent.com/leanprover/elan/${ELAN_COMMIT}/elan-init.sh" \
      -o /tmp/elan-init.sh && \
    sh /tmp/elan-init.sh -y --no-modify-path --default-toolchain none && \
    rm /tmp/elan-init.sh && \
    elan toolchain install "${LEAN_TOOLCHAIN}" && \
    elan default "${LEAN_TOOLCHAIN}" && \
    toolchain_dir="$(dirname "$(dirname "$(elan which lean)")")" && \
    ln -s "${toolchain_dir}" /opt/lean && \
    lean --version | grep -F "${LEAN_VERSION#v}"

COPY src/submission-validation/lean/inspector /tmp/laxinspector
RUN cd /tmp/laxinspector && \
    lake build laxinspector && \
    install -m 0555 .lake/build/bin/laxinspector /opt/lax-runtime/bin/laxinspector && \
    rm -rf /tmp/laxinspector

FROM tooling AS runtime
ARG LEAN_TOOLCHAIN=leanprover/lean4:v4.30.0
ARG LEAN_VERSION=v4.30.0
ARG MATHLIB_REPOSITORY=https://github.com/leanprover-community/mathlib4
ARG MATHLIB_COMMIT=c5ea00351c28e24afc9f0f84379aa41082b1188f
ARG LAYOUT_VERSION=1

# This layer is the expensive one. BuildKit's registry/GHA cache retains it
# across runtime releases; validation jobs only pull the finished image.
RUN --mount=type=cache,target=/opt/lax-runtime/home/.cache \
    mkdir -p /opt/lax-runtime/warm && \
    printf '%s\n' \
      'name = "LaxWarm"' \
      'defaultTargets = ["LaxWarm"]' \
      '' \
      '[[require]]' \
      'name = "mathlib"' \
      "git = \"${MATHLIB_REPOSITORY}\"" \
      "rev = \"${MATHLIB_COMMIT}\"" \
      '' \
      '[[lean_lib]]' \
      'name = "LaxWarm"' > /opt/lax-runtime/warm/lakefile.toml && \
    printf '%s\n' "${LEAN_TOOLCHAIN}" > /opt/lax-runtime/warm/lean-toolchain && \
    printf '%s\n' 'import Mathlib' > /opt/lax-runtime/warm/LaxWarm.lean && \
    cd /opt/lax-runtime/warm && \
    lake update && \
    test "$(git -C .lake/packages/mathlib rev-parse HEAD)" = "${MATHLIB_COMMIT}" && \
    lake exe cache get && \
    lake build && \
    chmod -R a+rX /opt/lax-runtime/warm

# Validation containers run as the invoking host user, while these immutable
# package checkouts are owned by root in the image. The warm build above makes
# their immutable artifacts readable, and this config trusts only these exact
# repositories so Lake can inspect their pinned remotes without cloning them.
RUN git_config=/opt/lax-runtime/warm-gitconfig && \
    for package in /opt/lax-runtime/warm/.lake/packages/*; do \
      git config --file "${git_config}" --add safe.directory "${package}"; \
    done && \
    chmod 0444 "${git_config}"

ENV GIT_CONFIG_GLOBAL=/opt/lax-runtime/warm-gitconfig

COPY src/submission-validation/runtime/fetch-source.mjs \
     src/submission-validation/runtime/source-repository.mjs \
     src/submission-validation/runtime/source-repository-hosts.json \
     src/submission-validation/runtime/download-capture.mjs \
     src/submission-validation/runtime/extract-capture.mjs \
     src/submission-validation/runtime/provision-workspace.mjs \
     src/submission-validation/runtime/run-check.mjs \
     /opt/lax-runtime/bin/

RUN chmod 0555 /opt/lax-runtime/bin/*.mjs && \
    chmod 0444 /opt/lax-runtime/bin/source-repository-hosts.json && \
    LAYOUT_VERSION="${LAYOUT_VERSION}" \
      LEAN_TOOLCHAIN="${LEAN_TOOLCHAIN}" \
      LEAN_VERSION="${LEAN_VERSION}" \
      MATHLIB_REPOSITORY="${MATHLIB_REPOSITORY}" \
      MATHLIB_COMMIT="${MATHLIB_COMMIT}" \
      node --input-type=module -e \
        'import fs from "node:fs"; const value = { layoutVersion: Number(process.env.LAYOUT_VERSION), leanToolchain: process.env.LEAN_TOOLCHAIN, leanVersion: process.env.LEAN_VERSION, mathlibRepository: process.env.MATHLIB_REPOSITORY, mathlibCommit: process.env.MATHLIB_COMMIT }; fs.writeFileSync("/opt/lax-runtime/runtime-manifest.json", JSON.stringify(value));' && \
    chmod 0444 /opt/lax-runtime/runtime-manifest.json

WORKDIR /work
CMD ["node", "--version"]
