# Task 2b follow-up: run the real `lake comparator` inside lax's image family.
# The comparator refuses to start without `git` and `env` on PATH; the slim
# base has `env` (coreutils) but no git.
FROM node:22-bookworm-slim@sha256:a17d50af28002a160548bd4225b3cfcb12c5efcb171f79e68758f2885fb1b066
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap git ca-certificates && rm -rf /var/lib/apt/lists/*
